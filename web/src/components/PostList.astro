---
import { postUrl, KIND_LABEL, type Post } from '../lib/posts';
import { formatDate } from '../lib/data';
interface Props { posts: Post[]; headingLevel?: 'h2' | 'h3' }
const { posts, headingLevel: H = 'h3' } = Astro.props;
---
<ol class="posts" role="list">
  {posts.map((p) => (
    <li data-kind={p.data.kind}>
      <a href={postUrl(p)} class="row">
        <span class="meta ui">
          <span class="kind">{KIND_LABEL[p.data.kind]}{p.data.verdict ? `: ${p.data.verdict}` : ''}</span>
          <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date, 'short')}</time>
        </span>
        <H class="title" data-vt={`post-${p.id}`}>{p.data.title}</H>
        <span class="summary mute">{p.data.summary}</span>
        {p.data.draft && <span class="draft ui">Draft</span>}
      </a>
    </li>
  ))}
</ol>

<style>
  .posts { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  li { border-bottom: 1px solid var(--line); }
  .row { display: grid; grid-template-columns: 11rem 1fr; column-gap: var(--space-6); row-gap: var(--space-1); padding-block: var(--space-5); text-decoration: none; }
  .meta { grid-row: span 2; display: grid; align-content: start; gap: 0.1em; font-size: var(--step--1); color: var(--mute); padding-top: 0.35em; }
  .kind { color: var(--magenta-text); font-weight: 600; }
  .title { font-size: var(--step-2); font-weight: 650; transition: color var(--dur) var(--ease); }
  .row:hover .title { color: var(--magenta-text); }
  .summary { font-size: var(--step-0); }
  .draft { grid-column: 2; justify-self: start; font-size: 0.75rem; border: 1px dashed var(--soon); color: var(--soon); border-radius: 100px; padding: 0 0.6em; }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr; } .meta { grid-row: auto; display: flex; gap: var(--space-3); } .draft { grid-column: 1; } }
</style>
