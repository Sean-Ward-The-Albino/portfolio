---
// A live Avlory item (a Quill doc, Tables, a Stage deck, a Canvas board or a published Survey) inside a post.
// Use it in .mdx posts: <AvloryEmbed link="https://hub.avlory.com/#/drive?item=..." caption="Our budget" />
// The item's owner must turn embedding on in Avlory and list this site. The frame never shares what it shows.
interface Props { link: string; caption?: string; height?: number }
const { link, caption, height } = Astro.props;
const ID = /^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/;
const m = link.match(/([0-9a-f-]{36})/);
const id = m && ID.test(m[1]) ? m[1] : null;
const survey = link.match(/^https:\/\/respond\.avlory\.com\/([a-z0-9-]{3,60})\/?$/)?.[1];
const src = id ? `https://embed.avlory.com/v1/i/${id}` : survey ? `https://embed.avlory.com/v1/survey/${survey}` : null;
if (!src) throw new Error(`AvloryEmbed: "${link}" isn't an Avlory item or published form link.`);
---
<figure class="embed">
  <avlory-embed src={src} mode="view" height={height} autoresize={height ? undefined : ''}></avlory-embed>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
