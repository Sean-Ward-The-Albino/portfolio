---
// The two circles from the Avlory logo, in Sean's magenta and Avlory blue.
interface Props { size?: number; class?: string }
const { size = 28, class: className } = Astro.props;
---
<svg class:list={['venn', className]} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <circle cx="12" cy="16" r="9" fill="#fd00de" />
  <circle class="venn-blue" cx="20" cy="16" r="9" fill="#2f71fd" />
</svg>
<style>.venn-blue { mix-blend-mode: screen; }</style>
