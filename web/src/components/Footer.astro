---
import Icon from './Icon.astro';
import { profile, avlory } from '../lib/data';
const year = new Date().getFullYear();
---
<footer class="site-footer ui">
  <div class="page grid">
    <div>
      <p class="name">{profile.name}</p>
      <p class="mute">{profile.role}, {profile.location}.</p>
    </div>
    <ul class="socials" role="list">
      {profile.socials.filter((s) => s.kind !== 'avlory').map((s) => (
        <li><a href={s.url} rel="me noopener" target="_blank"><Icon name={s.kind} size={20} label={s.label} /></a></li>
      ))}
      <li><a href="/rss.xml"><Icon name="rss" size={20} label="RSS feed" /></a></li>
    </ul>
    <p class="mute small">
      © {year} {profile.name}. Built with Astro and Spring Boot. Avlory facts last synced {new Date(avlory.syncedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}.
      No cookies, no trackers.
    </p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); margin-top: var(--space-9); padding-block: var(--space-7) var(--space-8); font-size: var(--step--1); }
  .grid { display: grid; gap: var(--space-5); grid-template-columns: 1fr auto; align-items: start; }
  .name { font-weight: 700; font-size: var(--step-0); }
  .small { grid-column: 1 / -1; max-width: 60ch; }
  .socials { display: flex; gap: var(--space-2); list-style: none; padding: 0; }
  .socials a { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; color: var(--mute); transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease); }
  .socials a:hover { color: var(--paper); background: var(--ink-3); }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
</style>
