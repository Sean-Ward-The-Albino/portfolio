---
import Icon from './Icon.astro';
import VennMark from './VennMark.astro';
import { profile } from '../lib/data';
interface Props { section?: string }
const { section } = Astro.props;
---
<header class="site-header" data-section={section}>
  <div class="page bar">
    <a class="wordmark" href="/" aria-label={`${profile.name}, home`}>{profile.name}</a>
    <div class="actions ui">
      <button class="action" type="button" data-open-palette aria-keyshortcuts="Meta+K Control+K /" aria-label="Search">
        <Icon name="search" size={18} />
        <span class="label">Search</span>
        <kbd class="kbd" data-kbd>Ctrl K</kbd>
      </button>
      <button class="action" type="button" data-reading-toggle aria-pressed="false" aria-label="Reading mode" title="Reading mode: larger, high-contrast text">
        <Icon name="type" size={18} />
        <span class="label">Reading mode</span>
      </button>
      <button class="action menu" type="button" data-open-wheel aria-haspopup="dialog">
        <VennMark size={22} />
        <span class="label always">Menu</span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 30;
    background: color-mix(in oklab, var(--ink) 72%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease);
  }
  .site-header[data-scrolled] { border-bottom-color: var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: 64px; }
  .wordmark {
    font-family: var(--font-display); font-weight: 700; font-size: 1.12rem; letter-spacing: -0.02em;
    text-decoration: none; view-transition-name: wordmark; white-space: nowrap;
  }
  .actions { display: flex; align-items: center; gap: var(--space-2); }
  .action {
    display: inline-flex; align-items: center; gap: 0.5em; min-height: 44px; min-width: 44px; justify-content: center;
    padding: 0 0.85em; border-radius: 100px; border: 1px solid var(--line); background: transparent; cursor: pointer;
    font-size: var(--step--1); font-weight: 500;
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .action:hover { background: var(--ink-3); }
  .action[aria-pressed='true'] { background: var(--paper); color: var(--ink); border-color: var(--paper); }
  .menu { view-transition-name: wheel-trigger; }
  .kbd { font-family: var(--font-ui); font-size: 0.78em; color: var(--mute); border: 1px solid var(--line); border-radius: 6px; padding: 0.05em 0.4em; }
  @media (max-width: 760px) {
    .label:not(.always), .kbd { display: none; }
    .action { padding: 0 0.7em; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const onScroll = () => header.toggleAttribute('data-scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  if (/Mac|iPhone|iPad/.test(navigator.platform)) document.querySelectorAll('[data-kbd]').forEach((k) => (k.textContent = '⌘K'));
</script>
