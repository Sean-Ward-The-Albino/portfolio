---
// "Now rating": Sean's latest ratings on Waverate, live from the Waverate Data API through this site's server.
// Hidden entirely when the server has no key configured or Waverate can't be reached.
interface Props { count?: number }
const { count = 3 } = Astro.props;
---
<section class="now-rating" data-now-rating data-count={count} hidden aria-labelledby="now-rating-title">
  <div class="record" aria-hidden="true">
    <div class="vinyl"><img class="label-art" alt="" width="120" height="120" decoding="async" /></div>
    <div class="arm"></div>
  </div>
  <div class="info">
    <h2 id="now-rating-title" class="ui kicker">Now rating on <a href="https://avlory.com/waverate/">Waverate</a></h2>
    <p class="title" data-title></p>
    <p class="artist mute ui" data-artist></p>
    <p class="score"><span data-score></span><span class="out ui mute"> / 10</span></p>
    <p class="when ui mute" data-when></p>
    <ol class="recent ui" data-recent role="list"></ol>
  </div>
</section>

<style>
  .now-rating { display: grid; grid-template-columns: auto 1fr; gap: var(--space-6); align-items: center; }
  .record { position: relative; width: clamp(150px, 22vw, 210px); aspect-ratio: 1; }
  .vinyl {
    position: absolute; inset: 0; border-radius: 50%; display: grid; place-items: center;
    background:
      radial-gradient(circle, transparent 0 31%, rgb(255 255 255 / 0.06) 31.5% 32%, transparent 32.5%),
      repeating-radial-gradient(circle, #111 0 2px, #1b1b1b 2.5px 3px),
      #111;
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.5), inset 0 0 0 1px rgb(255 255 255 / 0.05);
    animation: spin 5.5s linear infinite; animation-play-state: paused;
  }
  .vinyl::after { content: ''; position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(from 30deg, transparent, rgb(255 255 255 / 0.08) 10%, transparent 20%, transparent 50%, rgb(255 255 255 / 0.06) 60%, transparent 70%); }
  .label-art { width: 40%; height: 40%; border-radius: 50%; object-fit: cover; background: var(--magenta); border: 3px solid #111; }
  .now-rating.is-playing .vinyl { animation-play-state: running; }
  .arm { position: absolute; right: -6%; top: 2%; width: 8%; height: 58%; transform-origin: 50% 6%; rotate: -24deg; transition: rotate 900ms var(--ease);
    background: linear-gradient(#d9d2d6, #8d8489); border-radius: 6px; clip-path: polygon(35% 0, 65% 0, 60% 100%, 40% 100%); }
  .now-rating.is-playing .arm { rotate: 4deg; }
  .kicker { font-size: var(--step--1); font-weight: 600; color: var(--magenta-text); letter-spacing: 0; }
  .kicker a { color: inherit; }
  .title { font-family: var(--font-display); font-size: var(--step-2); font-weight: 700; line-height: 1.1; letter-spacing: -0.02em; margin-top: var(--space-2); }
  .artist { font-size: var(--step-0); }
  .score { font-family: var(--font-display); font-size: var(--step-3); font-weight: 800; line-height: 1; margin-top: var(--space-3); font-variant-numeric: tabular-nums; }
  .out { font-size: var(--step-0); font-weight: 500; }
  .when { font-size: var(--step--1); margin-top: var(--space-2); }
  .recent { list-style: none; padding: 0; margin-top: var(--space-4); display: grid; gap: var(--space-1); font-size: var(--step--1); color: var(--mute); }
  .recent :global(b) { color: var(--paper); font-variant-numeric: tabular-nums; margin-right: 0.5em; }
  @keyframes spin { to { rotate: 360deg; } }
  @media (max-width: 560px) { .now-rating { grid-template-columns: 1fr; } }
</style>

<script>
  type Rating = { title: string; artist: string; album?: string; value: number; ratedAt?: string; artwork?: string };
  const ago = (iso?: string) => {
    if (!iso) return '';
    const s = (Date.now() - new Date(iso).getTime()) / 1000;
    const fmt = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
    if (s < 3600) return fmt.format(-Math.max(1, Math.round(s / 60)), 'minute');
    if (s < 86400) return fmt.format(-Math.round(s / 3600), 'hour');
    return fmt.format(-Math.round(s / 86400), 'day');
  };
  for (const card of document.querySelectorAll<HTMLElement>('[data-now-rating]')) {
    const count = Number(card.dataset.count) || 3;
    fetch('/api/now/rating', { headers: { accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : null))
      .then((data: { ratings: Rating[] } | null) => {
        const [first, ...rest] = data?.ratings ?? [];
        if (!first) return;
        const set = (sel: string, text: string) => { card.querySelector(`[data-${sel}]`)!.textContent = text; };
        set('title', first.title);
        set('artist', [first.artist, first.album].filter(Boolean).join(', '));
        set('score', first.value.toFixed(2));
        set('when', first.ratedAt ? `Rated ${ago(first.ratedAt)}` : '');
        const art = card.querySelector<HTMLImageElement>('.label-art')!;
        if (first.artwork?.startsWith('https://')) art.src = first.artwork; else art.remove();
        const list = card.querySelector('[data-recent]')!;
        for (const r of rest.slice(0, count - 1)) {
          const li = document.createElement('li');
          const b = document.createElement('b');
          b.textContent = r.value.toFixed(2);
          li.append(b, `${r.title}, ${r.artist}`);
          list.append(li);
        }
        card.hidden = false;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          new IntersectionObserver(([e]) => card.classList.toggle('is-playing', e.isIntersecting)).observe(card);
        }
      })
      .catch(() => {});
  }
</script>
