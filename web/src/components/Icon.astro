---
// Inline SVG icons, resolved at build time: Lucide for interface icons, Simple Icons for brands.
// Nothing is fetched at runtime.
import * as lucide from 'lucide-static';
import { siGithub, siInstagram, siSpotify, siX, siDiscord } from 'simple-icons';

interface Props { name: string; size?: number; label?: string; class?: string }
const { name, size = 20, label, class: className } = Astro.props;

const brands: Record<string, { path: string }> = {
  github: siGithub, instagram: siInstagram, spotify: siSpotify, x: siX, discord: siDiscord,
  // Neither icon set ships LinkedIn any more; this is its plain "in" mark.
  linkedin: { path: 'M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8h4.56v14H.22V8zm7.48 0h4.37v1.92h.06c.61-1.15 2.1-2.36 4.33-2.36 4.63 0 5.48 3.05 5.48 7.01V22h-4.56v-6.62c0-1.58-.03-3.61-2.2-3.61-2.2 0-2.54 1.72-2.54 3.5V22H7.7V8z' },
};
const lucideNames: Record<string, string> = {
  search: 'Search', close: 'X', arrow: 'ArrowRight', external: 'ArrowUpRight',
  reading: 'Eye', menu: 'CircleDot', home: 'House', avlory: 'Orbit', writing: 'PenLine', about: 'User',
  now: 'Radio', check: 'Check', send: 'Send', offline: 'WifiOff', disc: 'Disc3', back: 'ArrowLeft',
  spark: 'Sparkles', think: 'Lightbulb', disagree: 'MessageCircleQuestion', heart: 'Heart', rss: 'Rss',
  sun: 'Sun', moon: 'Moon', type: 'Type',
};

let svg: string;
const brand = brands[name];
if (brand) {
  svg = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="${brand.path}"/></svg>`;
} else {
  const key = lucideNames[name] ?? name;
  const raw = (lucide as Record<string, string>)[key];
  if (!raw) throw new Error(`Icon "${name}" not found`);
  svg = raw.replace(/\s(class|width|height)="[^"]*"/g, '').replace(/\n\s*/g, ' ');
}
const attrs = `width="${size}" height="${size}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true"'} focusable="false"${className ? ` class="${className}"` : ''}`;
const html = svg.replace('<svg', `<svg ${attrs}`);
---
<Fragment set:html={html} />
