---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { products, avlory, STATUS_LABEL, compact, formatDate } from '../lib/data';

const { stats, roadmap, company } = avlory;
const langs = Object.entries(stats.languages);
const maxLines = Math.max(...langs.map(([, l]) => l.lines));
const totalLines = langs.reduce((s, [, l]) => s + l.lines, 0);
const spaces = ['Calendar', 'Projects', 'Messages', 'Mail', 'Connect', 'Quill', 'Tables', 'Stage', 'Survey', 'Canvas', 'Cloud'];
const orbitData = products.map(({ slug, name, color, status }) => ({ slug, name, color, status }));
const STATE_LABEL = { done: 'Shipped', now: 'In progress', next: 'Planned' } as const;

// The static orbit, drawn at build time: what people see before (or instead of) the 3D scene.
const rings = products.map((p, i) => ({ r: 120 + i * 48, color: p.color, angle: i * 1.9, status: p.status }));
---
<Base title="Avlory" section="avlory" description={`What Avlory is building: ${products.map((p) => p.name).join(', ')}. Live status, roadmap and engineering, from Sean D. Ward.`}>
  <section class="hero" aria-labelledby="avlory-heading">
    <div class="orbit" data-orbit>
      <svg class="orbit-static" viewBox="-420 -420 840 840" aria-hidden="true">
        {rings.map((r) => (
          <g>
            <ellipse rx={r.r} ry={r.r * 0.38} fill="none" stroke={r.color} stroke-opacity={r.status === 'soon' ? 0.2 : 0.4} />
            <circle cx={Math.cos(r.angle) * r.r} cy={Math.sin(r.angle) * r.r * 0.38} r={r.status === 'live' ? 9 : 7} fill={r.color} />
          </g>
        ))}
        <circle cx="-26" r="52" fill="#fd00de" />
        <circle cx="26" r="52" fill="#2f71fd" class="screen" />
      </svg>
      <script type="application/json" id="orbit-data" set:html={JSON.stringify(orbitData)} />
    </div>
    <div class="page hero-text">
      <h1 id="avlory-heading" class="title">Avlory</h1>
      <p class="lede">{company.tagline} {company.description}</p>
      <p class="mute ui small">I founded Avlory and lead it as CEO. Drag the system to turn it; select a planet to jump to it.</p>
    </div>
  </section>

  <section class="page products" aria-label="Products">
    {products.map((p) => (
      <article id={p.slug} class="product">
        <div class="p-head">
          {p.logo ? <img src={`/brand/${p.logo}`} alt="" width="64" height="64" loading="lazy" decoding="async" /> : <span class="p-dot" />}
          <div>
            <h2 class="p-name">{p.name}</h2>
            <p class="status" data-status={p.status}>
              {STATUS_LABEL[p.status]}
              {p.version && p.status === 'live' && <span class="mute">, version {p.version}</span>}
              {p.androidBeta && <span class="mute">, Android in beta</span>}
            </p>
          </div>
        </div>
        <p class="p-summary">{p.summary}</p>
        <p class="p-platforms ui mute">{p.platforms.join(', ')}</p>
        {p.roadmap.length > 0 && (
          <ol class="p-road ui" role="list">
            {p.roadmap.map((r) => <li data-state={r.state}><span class="r-name">{r.name}</span><span class="mute">{r.when || STATE_LABEL[r.state]}</span></li>)}
          </ol>
        )}
        <div class="p-links">
          {p.link && <a class="button" href={p.link.url} rel="noopener">{p.link.label} <Icon name="external" size={15} /></a>}
          {p.site && <a class="button button--quiet" href={p.site} rel="noopener">On avlory.com <Icon name="external" size={15} /></a>}
        </div>
      </article>
    ))}
  </section>

  <section class="page band" aria-labelledby="road-title">
    <h2 id="road-title" class="section-title">The roadmap</h2>
    <p class="mute section-lede">Straight from avlory.com, synced {formatDate(avlory.syncedAt)}.</p>
    <ol class="road" role="list">
      {roadmap.map((r) => (
        <li data-state={r.state}>
          <span class="node" aria-hidden="true"></span>
          <p class="r-when ui">{r.when || STATE_LABEL[r.state]}<span class="visually-hidden">, {STATE_LABEL[r.state]}</span></p>
          <h3>{r.name}</h3>
          <p class="r-theme ui">{r.theme}</p>
          <p class="mute">{r.detail.replace(/\s*Launched [^.]+\.$/, '')}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="page band" aria-labelledby="next-title">
    <h2 id="next-title" class="section-title">Avlory Next: eleven spaces, one place</h2>
    <p class="section-lede mute">Local-first and encrypted. Posts on this site can be written in Quill and carry live Tables, charts and Canvas boards from it.</p>
    <ul class="spaces" role="list">
      {spaces.map((s) => (
        <li><img src={`/brand/spaces/${s.toLowerCase()}.svg`} alt="" width="40" height="40" loading="lazy" decoding="async" /><span class="ui">{s}</span></li>
      ))}
    </ul>
  </section>

  <section class="page band" aria-labelledby="eng-title">
    <h2 id="eng-title" class="section-title">Under the hood</h2>
    <p class="section-lede mute">Counted from the Avlory codebase itself every time this site syncs, generated and vendored code left out.</p>
    <dl class="tiles">
      <div><dt>Apps and services</dt><dd>{stats.apps}</dd></div>
      <div><dt>Flutter apps</dt><dd>{stats.flutterApps}</dd></div>
      <div><dt>Spring Boot services</dt><dd>{stats.springServices}</dd></div>
      <div><dt>Shared packages</dt><dd>{stats.packages}</dd></div>
    </dl>
    <figure class="langs">
      <figcaption class="ui"><span>Lines of code by language</span><span class="mute">{compact(totalLines)} in total, Java {stats.java} and Spring Boot {stats.springBoot} on the server</span></figcaption>
      <ul role="list">
        {langs.map(([name, l]) => (
          <li title={`${name}: ${l.lines.toLocaleString('en-US')} lines in ${l.files.toLocaleString('en-US')} files`}>
            <span class="l-name ui">{name}</span>
            <svg class="l-track" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><rect class="l-bar" width={Math.max(1, (l.lines / maxLines) * 100)} height="10" rx="2" /></svg>
            <span class="l-val ui">{compact(l.lines)}</span>
          </li>
        ))}
      </ul>
    </figure>
  </section>
</Base>

<style>
  .hero { position: relative; margin-top: -64px; min-height: min(100svh, 1000px); display: grid; align-items: end; overflow: clip; }
  .orbit { position: absolute; inset: 0 0 12% 0; display: grid; place-items: center; touch-action: pan-y; user-select: none; }
  .orbit-static { width: min(100%, 860px); height: auto; opacity: 0.8; transition: opacity 1s var(--ease); }
  .orbit-static .screen { mix-blend-mode: screen; }
  .orbit:global(.is-live) .orbit-static { opacity: 0; }
  .orbit :global(.orbit-canvas) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .orbit :global(.orbit-labels) { position: absolute; inset: 0; pointer-events: none; }
  .orbit :global(.orbit-label) {
    position: absolute; left: 0; top: 0; translate: 14px -50%; white-space: nowrap; pointer-events: auto;
    font-size: 0.8rem; font-weight: 600; text-decoration: none; padding: 0.2em 0.6em; border-radius: 100px;
    background: color-mix(in oklab, var(--ink) 70%, transparent); border: 1px solid var(--line);
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  @media (max-width: 640px) { .orbit { inset: 0 0 38% 0; } .orbit :global(.orbit-label) { font-size: 0.72rem; } }
  .orbit :global(.orbit-label.is-left) { translate: calc(-100% - 14px) -50%; }
  .orbit :global(.orbit-label.is-hovered) { border-color: var(--magenta); background: var(--ink-3); }
  .hero-text { position: relative; padding-bottom: var(--space-7); pointer-events: none; }
  .hero-text > * { pointer-events: auto; max-width: fit-content; }
  .title { font-size: var(--step-5); font-weight: 800; letter-spacing: -0.055em; line-height: 0.9; }
  .lede { font-size: var(--step-1); max-width: 44ch; margin-top: var(--space-4); line-height: 1.45; }
  .small { font-size: var(--step--1); margin-top: var(--space-3); }

  .products { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); margin-top: var(--space-6); }
  .product { border: 1px solid var(--line); border-radius: calc(var(--radius) + 6px); padding: var(--space-6); display: grid; gap: var(--space-4); align-content: start; scroll-margin-top: 90px; background: linear-gradient(160deg, var(--ink-2), var(--ink)); }
  .product:target { border-color: var(--magenta); box-shadow: 0 0 0 1px var(--magenta); }
  .p-head { display: flex; gap: var(--space-4); align-items: center; }
  .p-head img, .p-dot { width: 64px; height: 64px; border-radius: 50%; flex: none; }
  .p-dot { background: radial-gradient(circle at 35% 35%, #c4c0ff, #8f8af5 60%, #4a43c9); }
  .p-name { font-size: var(--step-2); }
  .p-summary { font-size: var(--step-0); }
  .p-platforms { font-size: var(--step--1); }
  .p-road { list-style: none; padding: 0; display: grid; gap: var(--space-1); font-size: var(--step--1); border-top: 1px solid var(--line); padding-top: var(--space-3); }
  .p-road li { display: flex; justify-content: space-between; gap: var(--space-3); }
  .p-road li::before { content: ''; width: 8px; height: 8px; border-radius: 50%; margin-top: 0.55em; flex: none; border: 1.5px solid var(--mute); }
  .p-road li[data-state='done']::before { background: var(--live); border-color: var(--live); }
  .p-road li[data-state='now']::before { background: var(--magenta); border-color: var(--magenta); }
  .r-name { flex: 1; font-weight: 600; }
  .p-links { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: auto; }

  .band { margin-top: var(--space-9); }
  .section-title { font-size: var(--step-3); }
  .section-lede { max-width: 60ch; margin-top: var(--space-3); }

  /* The roadmap line draws itself as you scroll, in CSS alone where the browser supports it. */
  .road { list-style: none; padding: 0 0 0 var(--space-6); margin-top: var(--space-6); position: relative; display: grid; gap: var(--space-6); }
  .road::before { content: ''; position: absolute; left: 7px; top: 0; bottom: 0; width: 2px; background: linear-gradient(var(--magenta), var(--blue)); transform-origin: top; }
  @supports (animation-timeline: view()) {
    .road::before { animation: draw linear both; animation-timeline: view(); animation-range: entry 10% cover 60%; }
    .road li { animation: reveal linear both; animation-timeline: view(); animation-range: entry 0% entry 60%; }
  }
  @keyframes draw { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes reveal { from { opacity: 0.15; translate: 0 18px; } to { opacity: 1; translate: 0 0; } }
  .road li { position: relative; max-width: 62ch; }
  .node { position: absolute; left: calc(-1 * var(--space-6) + 1px); top: 0.45em; width: 14px; height: 14px; border-radius: 50%; background: var(--ink); border: 2px solid var(--mute); }
  .road li[data-state='done'] .node { background: var(--live); border-color: var(--live); }
  .road li[data-state='now'] .node { background: var(--magenta); border-color: var(--magenta); box-shadow: 0 0 0 6px color-mix(in oklab, var(--magenta) 25%, transparent); }
  .r-when { font-size: var(--step--1); font-weight: 600; color: var(--magenta-text); }
  .road h3 { font-size: var(--step-1); margin-top: var(--space-1); }
  .r-theme { font-weight: 500; margin-top: var(--space-1); }

  .spaces { list-style: none; padding: 0; margin-top: var(--space-6); display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: var(--space-3); }
  .spaces li { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4); border: 1px solid var(--line); border-radius: var(--radius); font-weight: 600; font-size: var(--step--1); }

  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--space-3); margin-top: var(--space-6); }
  .tiles div { border: 1px solid var(--line); border-radius: var(--radius); padding: var(--space-4) var(--space-5); }
  .tiles dt { font-family: var(--font-ui); font-size: var(--step--1); color: var(--mute); }
  .tiles dd { font-family: var(--font-display); font-size: var(--step-3); font-weight: 800; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .langs { margin-top: var(--space-6); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--space-5); }
  .langs figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2); font-weight: 600; font-size: var(--step--1); margin-bottom: var(--space-4); }
  .langs ul { list-style: none; padding: 0; display: grid; gap: var(--space-2); }
  .langs li { display: grid; grid-template-columns: 7.5rem 1fr 3.5rem; align-items: center; gap: var(--space-3); padding-block: 2px; border-radius: 6px; }
  .langs li:hover { background: var(--ink-2); }
  .l-name, .l-val { font-size: var(--step--1); }
  .l-val { text-align: right; font-variant-numeric: tabular-nums; color: var(--mute); }
  .l-track { width: 100%; height: 10px; overflow: visible; }
  .l-bar { fill: var(--magenta); }
  @supports (animation-timeline: view()) {
    .l-bar { transform-box: fill-box; transform-origin: left; animation: grow linear both; animation-timeline: view(); animation-range: entry 0% cover 35%; }
  }
  @keyframes grow { from { transform: scaleX(0); } }
</style>

<script>
  const host = document.querySelector<HTMLElement>('[data-orbit]');
  if (host) {
    const data = JSON.parse(document.getElementById('orbit-data')!.textContent!);
    const begin = () => import('../scripts/orbit').then((m) => m.startOrbit(host, data));
    if ('requestIdleCallback' in window) requestIdleCallback(begin, { timeout: 1200 }); else setTimeout(begin, 200);
  }
</script>
